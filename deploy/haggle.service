[Unit]
Description=haggle (multiplayer stock market game)
After=network-online.target postgresql.service
Wants=postgresql.service

[Service]
User=icarusfalls
WorkingDirectory=/opt/apps/Haggle
EnvironmentFile=/etc/apps/haggle.env
ExecStart=/usr/bin/node apps/server/dist/index.js
Restart=on-failure
RestartSec=5
# SIGTERM closes sockets and the pool; a restart mid-session replays the seeded market and resumes.
TimeoutStopSec=15
MemoryMax=512M
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
