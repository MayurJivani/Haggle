# Copy to .env. Everything except DATABASE_URL (or POSTGRES_PASSWORD under Docker) has a default.

# --- Required -----------------------------------------------------------------
# Local dev: the database the server connects to. Docker Compose builds this from POSTGRES_PASSWORD.
DATABASE_URL=postgres://haggle:haggle@127.0.0.1:5442/haggle
# Docker Compose only: password for the bundled Postgres. Generate with `openssl rand -hex 16`.
POSTGRES_PASSWORD=

# --- Organiser ----------------------------------------------------------------
# The host code: unlocks the /host console (QR join, open the bell, close early, next round) and GET /metrics.
# Unset: both routes answer 404. Generate with `openssl rand -hex 24` (24+ characters).
ADMIN_TOKEN=

# --- Session timing (seconds) -------------------------------------------------
# Defaults make a 15-minute event: 2 min lobby, 10 min trading (last minute is "last calls"), 3 min results.
LOBBY_SECONDS=120
TRADING_SECONDS=600
CLOSING_SECONDS=60
RESULTS_SECONDS=180
# Price tick length in ms (250 to 5000). Fewer, slower ticks = less traffic.
TICK_MS=1000
# Players dealt into one session; later arrivals watch and join the next one.
MAX_PLAYERS=500
# Fix the market seed for a reproducible demo. Unset = a fresh random market every session.
# MARKET_SEED=20261018

# --- Network ------------------------------------------------------------------
PORT=4371
# Extra origins allowed to POST and open the WebSocket. Unset = same host only, which is right behind
# a reverse proxy that keeps the Host header. Vite dev needs http://localhost:5273.
ALLOWED_ORIGINS=
# true only when a proxy you control sets X-Forwarded-For/-Proto (Caddy, Cloudflare tunnel).
# Needed for per-IP rate limits and Secure cookies behind TLS termination.
TRUST_PROXY=false
# Joins per IP per minute. A hosted event puts a whole room behind one NAT; raise it for load tests.
JOIN_RATE_LIMIT=120

LOG_LEVEL=info
NODE_ENV=production
